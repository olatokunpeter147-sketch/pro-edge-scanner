name: ProEdge Scanner

on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:
    inputs:
      test:
        description: 'Send a test message to Telegram (true/false)'
        required: false
        default: 'false'

permissions:
  contents: write

concurrency:
  group: proedge-scan
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Run scanner
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          TWELVEDATA_KEY: ${{ secrets.TWELVEDATA_KEY }}
          TEST_MODE: ${{ github.event.inputs.test }}
        run: node scan.mjs

      - name: Save scanner memory
        run: |
          git config user.name "proedge-bot"
          git config user.email "proedge-bot@users.noreply.github.com"
          git add state.json || true
          if ! git diff --cached --quiet; then
            git commit -m "scanner state"
            git pull --rebase
            git push
          fi
